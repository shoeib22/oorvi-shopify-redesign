<section class="page-hero">
  <p class="eyebrow eyebrow--light">Account</p>
  <h1 class="display">Your addresses</h1>
</section>

<div class="account-page">
  <div class="account-page__main reveal">
    {% if customer.addresses.size > 0 %}
      <div class="address-list">
        {% for address in customer.addresses %}
          <div class="address-card">
            {% if address == customer.default_address %}<span class="oil-card__badges"><span>Default</span></span>{% endif %}
            <p class="body-lg" style="margin-top: 10px;">
              {{ address.first_name }} {{ address.last_name }}<br>
              {{ address.address1 }}{% if address.address2 != blank %}, {{ address.address2 }}{% endif %}<br>
              {{ address.city }}, {{ address.province }} {{ address.zip }}<br>
              {{ address.country }}
            </p>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="body-lg">No saved addresses yet.</p>
    {% endif %}
  </div>

  <div class="account-page__side reveal">
    <div class="account-card">
      <p class="eyebrow">Add a New Address</p>
      {% form 'customer_address', customer.new_address %}
        {% if form.errors %}
          <p class="newsletter__error" style="color:#b5651d;">{{ form.errors | default_errors }}</p>
        {% endif %}
        <div class="contact-form__field">
          <label for="address-first-name">First name</label>
          <input type="text" id="address-first-name" name="address[first_name]" value="{{ form.first_name }}">
        </div>
        <div class="contact-form__field">
          <label for="address-last-name">Last name</label>
          <input type="text" id="address-last-name" name="address[last_name]" value="{{ form.last_name }}">
        </div>
        <div class="contact-form__field">
          <label for="address-1">Address</label>
          <input type="text" id="address-1" name="address[address1]" value="{{ form.address1 }}" required>
        </div>
        <div class="contact-form__field">
          <label for="address-city">City</label>
          <input type="text" id="address-city" name="address[city]" value="{{ form.city }}" required>
        </div>
        <div class="contact-form__field">
          <label for="address-province">State</label>
          <input type="text" id="address-province" name="address[province]" value="{{ form.province }}">
        </div>
        <div class="contact-form__field">
          <label for="address-zip">PIN code</label>
          <input type="text" id="address-zip" name="address[zip]" value="{{ form.zip }}" required>
        </div>
        <div class="contact-form__field">
          <label for="address-country">Country</label>
          <select id="address-country" name="address[country]">{{ country_option_tags }}</select>
        </div>
        <div class="contact-form__field">
          <label for="address-phone">Phone</label>
          <input type="tel" id="address-phone" name="address[phone]" value="{{ form.phone }}">
        </div>
        <button type="submit" class="btn btn--gold product__submit">Save address</button>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Addresses",
  "settings": []
}
{% endschema %}
