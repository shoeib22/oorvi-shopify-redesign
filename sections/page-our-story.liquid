    </div>
    <p class="campaign__hint">
      Scroll
      <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M1 5h15M11 1l5 4-5 4" stroke="currentColor" stroke-width="1.4"/></svg>
    </p>
  </div>
  <div class="campaign__scroll" id="campaignScroll">
    <img src="{{ 'campaign-groundnut.jpg' | asset_url }}" alt="Oorvi Groundnut Oil in the field" loading="lazy">
    <img src="{{ 'campaign-safflower.jpg' | asset_url }}" alt="Oorvi Safflower Oil in bloom" loading="lazy">
    <img src="{{ 'campaign-sesame.jpg' | asset_url }}" alt="Oorvi White Sesame Oil at golden hour" loading="lazy">
