<section class="account-shell wrap"><div class="account-art"><img src="{{ 'oorvi-hero-v4.webp' | asset_url }}" alt="Oorvi oils in warm morning light" width="1536" height="1024"><div><p class="eyebrow">Your daily dose of goodness</p><h2>A familiar place.<br>A little <em>goodness.</em></h2></div></div><div class="account-panel"><p class="eyebrow">Your Oorvi account</p><h1>Welcome <em>back.</em></h1><p>Log in to see your orders and saved addresses.</p>
{% form 'customer_login', class: 'account-form' %}{% if form.errors %}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="customer-email">Email address</label><input type="email" id="customer-email" name="customer[email]" autocomplete="email" required><label for="customer-password">Password</label><input type="password" id="customer-password" name="customer[password]" autocomplete="current-password" required><button class="button" type="submit">Log in {% render 'icon', name: 'arrow' %}</button>{% endform %}
<details class="account-recovery" id="recover"><summary>Forgot your password?</summary>{% form 'recover_customer_password', class: 'account-form' %}{% if form.posted_successfully? %}<p class="form-success" role="status">If that email has an account, a reset link is on its way.</p>{% else %}{% if form.errors %}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="recover-email">Email address</label><input type="email" id="recover-email" name="email" autocomplete="email" required><button class="button" type="submit">Send reset link</button>{% endif %}{% endform %}</details><p class="account-switch">New to Oorvi? <a href="{{ routes.account_register_url }}">Create an account ↗</a></p></div></section>
{% schema %}
{"name":"Welcome back","settings":[]}
{% endschema %}
