<footer class="site-footer">
  <div class="footer-top wrap">
    <div><p class="eyebrow">A little goodness in your inbox</p><h2>Stay close to<br>the good stuff.</h2><p>New pressings, kitchen inspiration, and stories from Oorvi.</p></div>
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {% if form.posted_successfully? %}<p role="status">You’re on the list. Welcome to Oorvi.</p>{% else %}
        <label for="newsletter-email">Your email address</label><div class="newsletter-field"><input type="email" id="newsletter-email" name="contact[email]" placeholder="you@example.com" autocomplete="email" required><button type="submit" aria-label="Subscribe to the newsletter">{% render 'icon', name: 'arrow' %}</button></div>
        <small>By subscribing, you agree to our <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">privacy policy</a>.</small>
        {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      {% endif %}
    {% endform %}
  </div>
  <div class="footer-main wrap"><a class="footer-brand" href="{{ routes.root_url }}"><img src="{{ 'oorvi-original-secondary.svg' | asset_url }}" alt="Oorvi - Premium Natural Products" width="230" height="122"><span>From the earth. For your everyday.</span></a><nav aria-label="Footer navigation"><a href="{{ routes.all_products_collection_url }}">Shop oils</a><a href="{{ pages['our-story'].url | default: '/pages/our-story' }}">Our story</a><a href="{{ pages['contact'].url | default: '/pages/contact' }}">Contact us</a><a href="https://www.instagram.com/oorvi.store/" target="_blank" rel="noopener">Instagram ↗</a></nav><div><a href="mailto:care@oorvi.store">care@oorvi.store</a><br><a href="tel:+919642114488">+91 96421 14488</a><p>Made with care in Hyderabad, India.</p></div></div>
  <div class="footer-bottom wrap"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Goodness. Naturally.</span><div><a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy</a><a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms</a><a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Returns</a><a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">Shipping</a></div></div>
</footer>
