<div class="font-sans antialiased text-brand-textDark selection:bg-brand-olive selection:text-white">

  <section class="w-full px-6 md:px-12 pt-8 pb-20 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-6 items-center relative rounded-b-[2.5rem] lg:rounded-b-[4rem] overflow-hidden bg-brand-bg"
    style="background-image: url('{{ 'hero-groundnut-lifestyle.png' | asset_url }}'); background-repeat: no-repeat; background-position: right center; background-size: cover;">

    <!-- Hero Left Content -->
    <div class="lg:col-span-7 flex flex-col justify-center relative z-10">
      <p class="text-xs font-semibold tracking-[0.2em] text-brand-textLight uppercase mb-6">Traditional Foods For A Brighter Tomorrow</p>

      <h2 class="font-serif text-6xl md:text-7xl lg:text-[5.5rem] leading-[1.05] text-brand-textDark mb-6">
        Pure.<br>
        Traditional.<br>
        <span class="italic font-medium">Thoughtfully Made.</span>
      </h2>

      <p class="text-brand-textLight md:text-lg max-w-lg mb-10 leading-relaxed font-light">
        At OORVI, we bring you nature's goodness through traditionally made, cold pressed oils — pure, wholesome and crafted for a healthier tomorrow.
      </p>

      <a href="{{ routes.all_products_collection_url | default: routes.collections_url }}" class="bg-brand-olive hover:bg-brand-oliveHover text-white px-8 py-3.5 rounded-full w-max flex items-center gap-3 font-medium transition duration-300 shadow-lg shadow-brand-olive/20 mb-16">
        Shop Now
        <i class="fa-solid fa-chevron-right text-sm"></i>
      </a>

      <!-- Features Row -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-0 border-l-2 sm:border-l-0 border-brand-border pl-4 sm:pl-0">

        <!-- Feature 1 -->
        <div class="flex items-center gap-4 sm:pr-8 sm:border-r border-brand-border">
          <div class="w-12 h-12 rounded-full border border-brand-textDark flex items-center justify-center flex-shrink-0 bg-brand-bg/70">
            <i class="fa-solid fa-leaf text-brand-textDark"></i>
          </div>
          <div>
            <h4 class="font-bold text-sm text-brand-textDark">Cold Pressed</h4>
            <p class="text-xs text-brand-textLight mt-0.5">Retains natural goodness</p>
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="flex items-center gap-4 sm:px-8 sm:border-r border-brand-border">
          <div class="w-12 h-12 rounded-full border border-brand-textDark flex items-center justify-center flex-shrink-0 bg-brand-bg/70">
            <i class="fa-solid fa-seedling text-brand-textDark"></i>
          </div>
          <div>
            <h4 class="font-bold text-sm text-brand-textDark">100% Natural</h4>
            <p class="text-xs text-brand-textLight mt-0.5">No chemicals. No compromise.</p>
          </div>
        </div>

        <!-- Feature 3 -->
        <div class="flex items-center gap-4 sm:pl-8">
          <div class="w-12 h-12 rounded-full border border-brand-textDark flex items-center justify-center flex-shrink-0 relative bg-brand-bg/70">
            <svg class="w-5 h-5 text-brand-textDark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M9 3H15M12 3V10L6 20H18L15 15" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-sm text-brand-textDark">No Additives</h4>
            <p class="text-xs text-brand-textLight mt-0.5">Just pure nutrition</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Hero Right — reserved so the background photo's bottle reads clearly on desktop -->
    <div class="lg:col-span-5 h-[360px] lg:h-[700px]"></div>
  </section>

  <!-- Products Section -->
  <section class="w-full bg-[#fcfbf9] px-6 md:px-12 py-16 border-t border-brand-border/40">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 gap-6">
      <div>
        <p class="text-xs font-bold tracking-[0.15em] text-brand-textLight uppercase mb-3">Our Products</p>
        <h2 class="font-serif text-4xl md:text-5xl text-brand-textDark leading-tight">
          Rooted in Tradition.<br>
          Made for Better Living.
        </h2>
      </div>
      <a href="{{ routes.all_products_collection_url | default: routes.collections_url }}" class="text-brand-textDark font-medium text-sm border-b border-brand-textDark pb-0.5 hover:text-brand-olive hover:border-brand-olive transition">
        View All Products <i class="fa-solid fa-chevron-right text-xs ml-1"></i>
      </a>
    </div>

    <!-- Product Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <!-- Product Card 1 -->
      <a href="{{ all_products['groundnut-oil-cold-pressed'].url | default: '/products/groundnut-oil-cold-pressed' }}" class="bg-brand-card rounded-2xl p-6 flex items-center gap-6 hover:shadow-lg transition duration-300 group cursor-pointer border border-transparent hover:border-brand-olive/20">
        <div class="w-24 h-40 bg-[#f4f1ea] rounded-lg shadow-inner flex items-center justify-center p-2 relative overflow-hidden">
          <img src="{{ 'groundnut-cp.png' | asset_url }}" alt="Groundnut Oil, Cold Pressed" class="w-full h-full object-contain" loading="lazy">
        </div>
        <div class="flex-1">
          <h3 class="font-serif text-xl font-medium text-brand-textDark mb-2">Groundnut Oil</h3>
          <p class="text-sm text-brand-textLight mb-4 font-light">Cold pressed for<br>pure nutrition.</p>
          <span class="text-brand-textDark font-medium text-sm border-b border-brand-textDark pb-0.5 group-hover:text-brand-olive group-hover:border-brand-olive transition inline-flex items-center gap-2">
            Shop Now <i class="fa-solid fa-arrow-right text-xs"></i>
          </span>
        </div>
      </a>

      <!-- Product Card 2 -->
      <a href="{{ all_products['white-sesame-oil-cold-pressed'].url | default: '/products/white-sesame-oil-cold-pressed' }}" class="bg-brand-card rounded-2xl p-6 flex items-center gap-6 hover:shadow-lg transition duration-300 group cursor-pointer border border-transparent hover:border-brand-olive/20">
        <div class="w-24 h-40 bg-[#f4f1ea] rounded-lg shadow-inner flex items-center justify-center p-2 relative overflow-hidden">
          <img src="{{ 'white-sesame-cp.png' | asset_url }}" alt="Sesame Oil, Cold Pressed" class="w-full h-full object-contain" loading="lazy">
        </div>
        <div class="flex-1">
          <h3 class="font-serif text-xl font-medium text-brand-textDark mb-2">Sesame Oil</h3>
          <p class="text-sm text-brand-textLight mb-4 font-light">Traditionally extracted<br>for rich flavour.</p>
          <span class="text-brand-textDark font-medium text-sm border-b border-brand-textDark pb-0.5 group-hover:text-brand-olive group-hover:border-brand-olive transition inline-flex items-center gap-2">
            Shop Now <i class="fa-solid fa-arrow-right text-xs"></i>
          </span>
        </div>
      </a>

      <!-- Product Card 3 -->
      <a href="{{ all_products['coconut-oil-wood-pressed'].url | default: '/products/coconut-oil-wood-pressed' }}" class="bg-brand-card rounded-2xl p-6 flex items-center gap-6 hover:shadow-lg transition duration-300 group cursor-pointer border border-transparent hover:border-brand-olive/20">
        <div class="w-24 h-40 bg-[#f4f1ea] rounded-lg shadow-inner flex items-center justify-center p-2 relative overflow-hidden">
          <img src="{{ 'coconut-wp.png' | asset_url }}" alt="Coconut Oil, Wood Pressed" class="w-full h-full object-contain" loading="lazy">
        </div>
        <div class="flex-1">
          <h3 class="font-serif text-xl font-medium text-brand-textDark mb-2">Coconut Oil</h3>
          <p class="text-sm text-brand-textLight mb-4 font-light">Pure, natural and<br>perfect for everyday.</p>
          <span class="text-brand-textDark font-medium text-sm border-b border-brand-textDark pb-0.5 group-hover:text-brand-olive group-hover:border-brand-olive transition inline-flex items-center gap-2">
            Shop Now <i class="fa-solid fa-arrow-right text-xs"></i>
          </span>
        </div>
      </a>

    </div>
  </section>

</div>

{% schema %}
{
  "name": "Oorvi Homepage (Redesign)",
  "settings": []
}
{% endschema %}
