<section class="page-intro wrap"><div><p class="eyebrow">Find your everyday goodness</p><h1>Looking for<br><em>something good?</em></h1></div></section>
<div class="wrap search-experience" data-search-endpoint="{{ routes.predictive_search_url }}">
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" data-oil-search>
    <label for="search-query" class="visually-hidden">Search Oorvi oils</label>
    <input id="search-query" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Try groundnut, sesame, or coconut" autocomplete="off" aria-describedby="search-status" aria-controls="search-suggestions" required>
    <input type="hidden" name="type" value="product"><input type="hidden" name="options[prefix]" value="last"><input type="hidden" name="options[unavailable_products]" value="show">
    <button type="submit" class="button">Search {% render 'icon', name: 'search' %}</button>
  </form>
  <p id="search-status" class="search-status" role="status" aria-live="polite">Type an oil or seed name to find your match.</p>
  <div id="search-suggestions" class="search-suggestion-panel" aria-label="Suggested products" hidden></div>
  {% if search.performed %}
    {% paginate search.results by 16 %}
      <div class="search-results-heading"><p class="eyebrow">{{ search.results_count }} {% if search.results_count == 1 %}oil{% else %}oils{% endif %} for &ldquo;{{ search.terms | escape }}&rdquo;</p><a class="text-link" href="{{ routes.search_url }}">Clear search</a></div>
      {% if search.results_count > 0 %}<div class="oil-grid catalog-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% assign tone = forloop.index0 | modulo: 4 | plus: 1 %}{% render 'oil-card', oil: item, tone: tone %}{% endif %}{% endfor %}</div>
      {% else %}<div class="empty-state"><h2>No match just yet.</h2><p>Try a seed name like groundnut or sesame, or explore our full oil range.</p><a class="button" href="{{ routes.all_products_collection_url }}">Shop all oils {% render 'icon', name: 'arrow' %}</a></div>{% endif %}
      {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Search pages">{{ paginate | default_pagination }}</nav>{% endif %}
    {% endpaginate %}
  {% else %}<div class="search-start"><p class="eyebrow">Start with a favourite</p><div class="finder-buttons"><a href="{{ routes.search_url }}?q=groundnut&amp;type=product" class="search-chip">Groundnut</a><a href="{{ routes.search_url }}?q=coconut&amp;type=product" class="search-chip">Coconut</a><a href="{{ routes.search_url }}?q=sesame&amp;type=product" class="search-chip">Sesame</a><a href="{{ routes.search_url }}?q=mustard&amp;type=product" class="search-chip">Mustard</a></div></div>{% endif %}
</div>
{% schema %}
{"name":"Search Oorvi","settings":[]}
{% endschema %}
