<section class="page-intro wrap"><div><p class="eyebrow">Your everyday essentials</p><h1>Your bag of<br><em>goodness.</em></h1></div><a href="{{ routes.all_products_collection_url }}" class="text-link">Keep exploring {% render 'icon', name: 'arrow' %}</a></section>
<div class="wrap">
{% if cart.item_count > 0 %}
  {% form 'cart', cart, class: 'cart-form' %}
    <div class="cart-layout"><div class="cart-items"><div class="cart-list-heading"><span>{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %} in your bag</span><span>Made for your kitchen.</span></div>{% for item in cart.items %}<article class="cart-item"><a href="{{ item.url }}" class="cart-photo">{% if item.image %}<img src="{{ item.image | image_url: width: 250 }}" alt="{{ item.product.title | escape }}" width="250" height="250" loading="lazy">{% endif %}</a><div class="cart-item-details"><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.variant.title == 'Default Title' %}<p>{{ item.variant.title }}</p>{% endunless %}<p>{{ item.final_price | money }} each</p><a class="cart-remove" href="{{ item.url_to_remove }}" aria-label="Remove {{ item.product.title | escape }}">Remove</a></div><div class="cart-item-end"><div class="quantity-control"><button type="button" data-quantity="minus" aria-label="Decrease quantity for {{ item.product.title | escape }}">−</button><input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}"><button type="button" data-quantity="plus" aria-label="Increase quantity for {{ item.product.title | escape }}">+</button></div><strong>{{ item.final_line_price | money }}</strong></div></article>{% endfor %}<button class="text-link cart-update" type="submit" name="update">Update your bag {% render 'icon', name: 'arrow' %}</button></div><aside class="cart-summary"><p class="eyebrow">Your kitchen, a little purer</p><h2>Order summary</h2><div><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>{% for discount in cart.cart_level_discount_applications %}<div><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>{% endfor %}<p>Shipping and taxes calculated at checkout.</p><button type="submit" name="checkout" class="button">Continue to checkout {% render 'icon', name: 'arrow' %}</button><small>Secure checkout through Shopify.</small></aside></div>
  {% endform %}
{% else %}
  <div class="empty-state"><div class="empty-bag">{% render 'icon', name: 'bag' %}</div><h2>Goodness is just<br>a bottle <em>away.</em></h2><p>Your bag is empty. Let’s find something that feels at home in your kitchen.</p><a href="{{ routes.all_products_collection_url }}" class="button">Discover our oils {% render 'icon', name: 'arrow' %}</a></div>
{% endif %}
</div>
{% schema %}
{"name":"Your bag","settings":[]}
{% endschema %}
