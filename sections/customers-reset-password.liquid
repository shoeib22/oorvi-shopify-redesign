<section class="account-shell wrap"><div class="account-art"><img src="{{ 'oorvi-hero-v4.webp' | asset_url }}" alt="Oorvi groundnut and coconut oils in warm morning light" width="1536" height="1024"><div><p class="eyebrow">A fresh start</p><h2>Back to<br><em>goodness.</em></h2></div></div><div class="account-panel"><p class="eyebrow">Your Oorvi account</p><h1>A fresh<br><em>password.</em></h1><p>Set your new password to get back to your account.</p>{% form 'reset_customer_password', class: 'account-form' %}{% if form.errors %}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="reset-password">New password</label><input id="reset-password" type="password" name="customer[password]" autocomplete="new-password" required><label for="reset-password-confirmation">Confirm password</label><input id="reset-password-confirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required><button class="button" type="submit">Reset password {% render 'icon', name: 'arrow' %}</button>{% endform %}<p class="account-switch"><a href="{{ routes.account_login_url }}">Back to log in ↗</a></p></div></section>
{% schema %}
{"name":"Reset password","settings":[]}
{% endschema %}
