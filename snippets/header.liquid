<a href="#main-content" class="skip-link">Skip to content</a>
<div class="announcement"><span>Good seeds. Honest pressing. Everyday goodness.</span><a href="{{ routes.all_products_collection_url }}">Meet your kitchen essentials <span aria-hidden="true">↗</span></a></div>
<header class="site-header" id="nav">
  <a href="{{ routes.root_url }}" class="brand" aria-label="Oorvi home"><img src="{{ 'oorvi-original-primary.svg' | asset_url }}" alt="Oorvi ? Premium Natural Products" width="150" height="90"></a>
  <nav class="desktop-nav" aria-label="Main navigation">
    <a href="{{ routes.all_products_collection_url }}" {% if template.name == 'collection' or template.name == 'product' %}aria-current="page"{% endif %}>Shop</a>
    <a href="{{ pages['our-story'].url | default: '/pages/our-story' }}" {% if page.handle == 'our-story' %}aria-current="page"{% endif %}>The Oorvi way</a>
    <a href="{{ routes.root_url }}#oil-finder">Find your oil</a>
    <a href="{{ pages['contact'].url | default: '/pages/contact' }}" {% if page.handle == 'contact' %}aria-current="page"{% endif %}>Let’s talk</a>
  </nav>
  <div class="header-actions">
    <a href="{{ routes.search_url }}" class="icon-button" aria-label="Search oils">{% render 'icon', name: 'search' %}</a>
    {% if shop.customer_accounts_enabled %}<a class="icon-button account-link" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Your account">{% render 'icon', name: 'user' %}</a>{% endif %}
    <a href="{{ routes.cart_url }}" class="cart-link" aria-label="Shopping bag, {{ cart.item_count }} items">{% render 'icon', name: 'bag' %}<span data-cart-count>{{ cart.item_count }}</span></a>
    <button class="icon-button menu-toggle" id="menuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">{% render 'icon', name: 'menu' %}</button>
  </div>
</header>
<div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Navigation" hidden>
  <div class="mobile-menu-top"><a href="{{ routes.root_url }}"><img src="{{ 'oorvi-original-primary.svg' | asset_url }}" alt="Oorvi" width="110" height="93"></a><button class="icon-button" id="menuClose" aria-label="Close menu">{% render 'icon', name: 'close' %}</button></div>
  <nav aria-label="Mobile navigation"><a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="{{ pages['our-story'].url | default: '/pages/our-story' }}">The Oorvi way</a><a href="{{ routes.root_url }}#oil-finder">Find your oil</a><a href="{{ pages['contact'].url | default: '/pages/contact' }}">Let’s talk</a><a href="{{ routes.account_login_url }}">Your account</a></nav>
  <p>Rooted in tradition.<br>Made for your everyday.</p>
</div>
