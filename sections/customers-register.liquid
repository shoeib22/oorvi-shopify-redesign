<section class="account-shell wrap"><div class="account-art"><img src="{{ 'oorvi-craft-v3.webp' | asset_url }}" alt="Golden oil poured into a ceramic bowl" width="1536" height="1024"><div><p class="eyebrow">Make yourself at home</p><h2>Good ingredients.<br><em>Good company.</em></h2></div></div><div class="account-panel"><p class="eyebrow">Join the Oorvi family</p><h1>A little more<br><em>goodness.</em></h1><p>Create your account for orders and saved addresses.</p>
{% form 'create_customer', class: 'account-form' %}{% if form.errors %}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<div class="account-name-fields"><div><label for="register-first-name">First name</label><input id="register-first-name" type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name | escape }}"></div><div><label for="register-last-name">Last name</label><input id="register-last-name" type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name | escape }}"></div></div><label for="register-email">Email address</label><input id="register-email" type="email" name="customer[email]" autocomplete="email" value="{{ form.email | escape }}" required><label for="register-password">Password</label><input id="register-password" type="password" name="customer[password]" autocomplete="new-password" required><button type="submit" class="button">Create your account {% render 'icon', name: 'arrow' %}</button>{% endform %}<p class="account-switch">Already feel at home here? <a href="{{ routes.account_login_url }}">Log in ↗</a></p></div></section>
{% schema %}
{"name":"Join Oorvi","settings":[]}
{% endschema %}
