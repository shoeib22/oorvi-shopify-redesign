<!-- HERO -->
<section class="hero">
  <div class="hero__content">
    <p class="eyebrow">A1 Native Seed · Single Pressing · Zero Filtration</p>
    <h1 class="hero__title">Nothing added.<br>Nothing <em>taken away</em>.</h1>
    <p class="hero__sub">
      Every Oorvi oil is pressed once, from the first pressing only, and left to
      settle rather than refined. Eight oils. One honest process.
    </p>
    <div class="hero__actions">
      <a href="#range" class="btn btn--gold">Explore the range</a>
      <a href="#craft" class="btn btn--ghost">Our craft</a>
    </div>
  </div>
  <div class="hero__stage">
    <div class="hero__stage-glow" aria-hidden="true"></div>
    <img src="{{ 'groundnut-cp-trimmed.png' | asset_url }}" alt="Oorvi Cold-Pressed Groundnut Oil" width="420" height="640" loading="eager">
    <p class="hero__stage-caption">Cold-Pressed Groundnut Oil, 1&nbsp;L</p>
  </div>
</section>

<!-- TRUST MARQUEE -->
<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    <div class="marquee__set">
      <span class="marquee__item">A1 Native Seed<span class="marquee__dot">&middot;</span></span>
      <span class="marquee__item">Single Pressed<span class="marquee__dot">&middot;</span></span>
      <span class="marquee__item">Zero Filtration<span class="marquee__dot">&middot;</span></span>
    </div>
    <div class="marquee__set">
      <span class="marquee__item">A1 Native Seed<span class="marquee__dot">&middot;</span></span>
      <span class="marquee__item">Single Pressed<span class="marquee__dot">&middot;</span></span>
      <span class="marquee__item">Zero Filtration<span class="marquee__dot">&middot;</span></span>
    </div>
  </div>
</div>

<!-- OUR CRAFT -->
<section class="craft" id="craft">
  <div class="craft__intro reveal">
    <p class="eyebrow">Our Craft</p>
    <h2 class="display display--italic">Pressed once,<br>never refined.</h2>
    <p class="body-lg">
      Single-pressed cold-pressed oil is extracted through mechanical pressing at
      low temperature — the first pressing only, the highest quality there is.
      Nothing is refined out, so the natural flavour, aroma and nutrients of the
      seed stay exactly as they were.
    </p>
    <a href="{{ pages['our-story'].url | default: '/pages/our-story' }}" class="btn btn--ghost">Read the full story</a>
  </div>

  <div class="process reveal">
    <div class="process__step">
      <span class="process__num">01</span>
      <h3>Seed</h3>
      <p>A1-grade native variety, sourced from trusted farms across India.</p>
    </div>
    <div class="process__step">
      <span class="process__num">02</span>
      <h3>Press</h3>
      <p>A single mechanical pass, kept at low temperature throughout.</p>
    </div>
    <div class="process__step">
      <span class="process__num">03</span>
      <h3>Rest</h3>
      <p>Naturally settled — no chemical filtration, no shortcuts.</p>
    </div>
    <div class="process__step">
      <span class="process__num">04</span>
      <h3>Bottle</h3>
      <p>Sealed close to the press, so nothing is lost in between.</p>
    </div>
  </div>
</section>

<!-- SPOTLIGHT -->
<section class="spotlight">
  <div class="spotlight__text reveal">
    <p class="eyebrow eyebrow--light">Wood Pressed</p>
    <h2 class="display display--italic">Slower by design,<br>richer for it.</h2>
    <p class="body-lg">
      Our wood-pressed line runs through a traditional stone-and-wood ghani,
      turning slowly to keep temperatures low and nutrients intact — a
      centuries-old method we haven't tried to speed up.
    </p>
    <a href="#range" class="btn btn--gold">Shop wood pressed</a>
  </div>
  <div class="spotlight__figure reveal">
    <div class="spotlight__figure-glow" aria-hidden="true"></div>
    <img src="{{ 'groundnut-wp.png' | asset_url }}" alt="Oorvi Wood-Pressed Groundnut Oil" width="360" height="560" loading="lazy">
  </div>
</section>

