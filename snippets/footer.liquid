<!-- Newsletter -->
<div class="w-full bg-[#3b4a1c] text-white py-14 px-6 text-center">
  <p class="uppercase tracking-widest text-[0.65rem] text-[#a9b889] mb-3 font-semibold">Join the List</p>
  <h3 class="font-serif text-3xl md:text-4xl mb-6">First pressing news, before anyone else.</h3>
  {% form 'customer' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {% if form.posted_successfully? %}
      <p class="text-[#e8cf5c] font-medium">You're on the list — welcome to Oorvi.</p>
    {% else %}
      <div class="flex max-w-md mx-auto relative">
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input type="email" id="newsletter-email" name="contact[email]" placeholder="Email address" required
          class="w-full bg-[#2f3d1b] border border-[#4a5d23] text-white px-5 py-3 rounded-l-md focus:outline-none placeholder:text-[#a9b889]">
        <button type="submit" class="bg-[#e8cf5c] text-brand-textDark font-semibold px-6 py-3 rounded-r-md hover:bg-[#d8c050] transition">Subscribe</button>
      </div>
      {% if form.errors %}
        <p class="text-sm text-red-300 mt-3">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {% endif %}
    {% endif %}
  {% endform %}
</div>

<footer class="bg-brand-card py-12 px-6 md:px-12 border-t border-brand-border">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center mb-10 gap-8">
    <a href="{{ routes.root_url }}" class="flex flex-col items-center">
      <h2 class="font-serif text-3xl tracking-widest text-brand-olive uppercase leading-none">{{ shop.name }}</h2>
      <p class="text-[0.45rem] tracking-[0.25em] text-brand-textLight mt-1 font-medium">GOODNESS. NATURALLY.</p>
    </a>

    <nav class="flex flex-wrap justify-center gap-6 text-sm font-medium text-brand-textDark">
      <a href="{{ routes.all_products_collection_url | default: routes.collections_url }}" class="hover:text-brand-olive transition">Shop</a>
      <a href="{{ pages['our-story'].url | default: '/pages/our-story' }}" class="hover:text-brand-olive transition">Our Story</a>
      <a href="{{ pages['contact'].url | default: '/pages/contact' }}" class="hover:text-brand-olive transition">Contact</a>
    </nav>

    <div class="flex gap-4 text-lg text-brand-textDark">
      <a href="https://www.instagram.com/oorvi.store/" target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-brand-olive transition bg-brand-bg w-10 h-10 rounded-full flex items-center justify-center"><i class="fa-brands fa-instagram"></i></a>
      <a href="https://www.facebook.com/profile.php?id=61576821724627" target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-brand-olive transition bg-brand-bg w-10 h-10 rounded-full flex items-center justify-center"><i class="fa-brands fa-facebook-f"></i></a>
      <a href="https://youtube.com/@oorvistore" target="_blank" rel="noopener" aria-label="YouTube" class="hover:text-brand-olive transition bg-brand-bg w-10 h-10 rounded-full flex items-center justify-center"><i class="fa-brands fa-youtube"></i></a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto text-center md:text-left text-xs text-brand-textLight pt-8 border-t border-brand-border/60 flex flex-col md:flex-row justify-between gap-4">
    <p>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</p>
    <p class="font-medium">FSSAI 23624028002885 &nbsp;&middot;&nbsp; ISO 9000:2015 &nbsp;&middot;&nbsp; ISO 22000:2018</p>
  </div>
</footer>
