<div class="font-sans antialiased text-brand-textDark bg-brand-bg min-h-screen">
  <section class="w-full pt-28 pb-12 px-6 md:px-12 text-center">
    <p class="uppercase tracking-[0.3em] text-xs font-semibold text-brand-textLight mb-4">Your Cart</p>
    <h1 class="text-4xl md:text-6xl font-serif text-brand-textDark">
      {% if cart.item_count > 0 %}{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}{% else %}Your cart is empty{% endif %}
    </h1>
  </section>

  <div class="max-w-6xl mx-auto px-6 md:px-12 pb-24">
    {% if cart.item_count > 0 %}
      {% form 'cart', cart %}
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-12 items-start">
          <div class="flex flex-col gap-6">
            {% for item in cart.items %}
              <div class="flex gap-4 md:gap-6 items-center bg-white p-4 rounded-2xl shadow-sm border border-brand-border/40">
                <div class="w-20 h-20 md:w-24 md:h-24 rounded-xl bg-brand-card border border-black/5 flex items-center justify-center shrink-0 overflow-hidden">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" loading="lazy" width="200" height="200" class="w-full h-full object-contain">
                  {% endif %}
                </div>
                <div class="flex-grow min-w-0">
                  <h4 class="font-serif text-lg text-brand-textDark leading-tight truncate">{{ item.product.title }}</h4>
                  {% unless item.variant.title == "Default Title" %}
                    <p class="text-xs text-brand-textLight mt-1">{{ item.variant.title }}</p>
                  {% endunless %}
                  <p class="text-xs text-brand-textLight mt-1">{{ item.final_price | money }} each</p>
                </div>
                <div class="flex items-center border border-brand-border rounded-full p-1 bg-white shrink-0">
                  <button type="button" aria-label="Decrease quantity" onclick="this.nextElementSibling.stepDown();this.nextElementSibling.form.requestSubmit()" class="w-9 h-9 rounded-full flex items-center justify-center hover:bg-brand-bg transition">&minus;</button>
                  <input type="number" name="updates[{{ forloop.index0 }}]" value="{{ item.quantity }}" min="0" aria-label="Quantity" class="w-9 text-center bg-transparent focus:outline-none">
                  <button type="button" aria-label="Increase quantity" onclick="this.previousElementSibling.stepUp();this.previousElementSibling.form.requestSubmit()" class="w-9 h-9 rounded-full flex items-center justify-center hover:bg-brand-bg transition">&plus;</button>
                </div>
                <div class="font-medium text-brand-textDark w-20 text-right shrink-0">{{ item.final_line_price | money }}</div>
              </div>
            {% endfor %}
          </div>

          <div class="bg-brand-card rounded-2xl p-6 sticky top-28">
            <div class="flex justify-between items-center mb-4">
              <span class="text-brand-textLight font-medium">Subtotal</span>
              <span class="font-serif text-2xl text-brand-textDark">{{ cart.total_price | money }}</span>
            </div>
            <p class="text-xs text-brand-textLight mb-6">Shipping and taxes calculated at checkout.</p>
            <button type="submit" name="checkout" class="w-full bg-brand-textDark text-white py-4 rounded-full uppercase tracking-widest text-xs font-bold hover:bg-brand-olive transition mb-3">Proceed to Checkout</button>
            <a href="{{ routes.all_products_collection_url | default: routes.collections_url }}" class="block text-center w-full border border-brand-border text-brand-textDark py-4 rounded-full uppercase tracking-widest text-xs font-bold hover:border-brand-olive hover:text-brand-olive transition">Continue Shopping</a>
          </div>
        </div>
      {% endform %}
    {% else %}
      <div class="text-center py-24 px-6 border border-dashed border-brand-border rounded-2xl">
        <p class="font-serif text-3xl text-brand-textDark mb-4">Nothing here yet.</p>
        <p class="text-brand-textLight max-w-md mx-auto mb-8">Browse the range and find your first pressing.</p>
        <a href="{{ routes.all_products_collection_url | default: routes.collections_url }}" class="bg-brand-olive hover:bg-brand-oliveHover text-white px-8 py-3.5 rounded-full inline-flex items-center gap-3 font-medium transition duration-300">
          Shop the range <i class="fa-solid fa-chevron-right text-xs"></i>
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
