<div class="font-sans antialiased text-brand-textDark bg-brand-bg min-h-screen">
  <section class="w-full pt-28 pb-12 px-6 text-center">
    <p class="uppercase tracking-[0.3em] text-xs font-semibold text-brand-textLight mb-4">Order {{ order.name }}</p>
    <h1 class="text-4xl md:text-6xl font-serif text-brand-textDark">{{ order.created_at | date: "%d %B %Y" }}</h1>
  </section>

  <div class="max-w-5xl mx-auto px-6 md:px-12 pb-24 grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-12 items-start">
    <div class="flex flex-col gap-4">
      {% for line_item in order.line_items %}
        <div class="flex gap-5 items-center bg-white p-4 rounded-2xl border border-brand-border/40">
          <div class="w-20 h-20 rounded-xl bg-brand-card flex items-center justify-center shrink-0 overflow-hidden">
            {% if line_item.image %}
              <img src="{{ line_item.image | image_url: width: 200 }}" alt="{{ line_item.title }}" width="200" height="200" class="w-full h-full object-contain">
            {% endif %}
          </div>
          <div class="flex-grow">
            <p class="font-serif text-lg text-brand-textDark">{{ line_item.title }}</p>
            <p class="text-xs text-brand-textLight mt-1">Qty {{ line_item.quantity }}</p>
          </div>
          <p class="font-medium text-brand-textDark">{{ line_item.final_line_price | money }}</p>
        </div>
      {% endfor %}
    </div>

    <div class="bg-brand-card rounded-2xl p-6">
      <div class="flex justify-between items-center mb-2">
        <span class="text-brand-textLight font-medium">Total</span>
        <span class="font-serif text-2xl text-brand-textDark">{{ order.total_price | money }}</span>
      </div>
      <p class="text-xs text-brand-textLight mb-6">{{ order.fulfillment_status_label }} &middot; {{ order.financial_status_label }}</p>
      {% if order.shipping_address %}
        <div class="border-t border-brand-border/50 pt-4 mb-6">
          <p class="text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-2">Shipping to</p>
          <p class="text-sm text-brand-textDark">{{ order.shipping_address.address1 }}, {{ order.shipping_address.city }} {{ order.shipping_address.zip }}</p>
        </div>
      {% endif %}
      <a href="{{ routes.account_url }}" class="block text-center w-full border border-brand-border text-brand-textDark py-3.5 rounded-full uppercase tracking-widest text-xs font-bold hover:border-brand-olive hover:text-brand-olive transition">Back to Account</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Order",
  "settings": []
}
{% endschema %}
