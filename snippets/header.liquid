<header class="w-full px-6 md:px-12 py-5 flex items-center justify-between z-50 font-sans {% if template.name == 'index' %}absolute top-0 left-0 bg-transparent{% else %}relative bg-brand-bg{% endif %}" id="nav">

  <!-- Logo -->
  <a href="{{ routes.root_url }}" class="flex items-center flex-shrink-0">
    <img src="{{ 'primary-logo.png' | asset_url }}" alt="{{ shop.name }}" width="150" height="59" class="h-12 md:h-14 w-auto">
  </a>

  <!-- Desktop Navigation -->
  <nav class="hidden md:flex items-center gap-10">
    <a href="{{ routes.root_url }}" class="text-sm font-medium pb-1 border-b-2 {% if template.name == 'index' %}border-brand-textDark text-brand-textDark{% else %}border-transparent text-brand-textLight hover:text-brand-textDark transition{% endif %}">Home</a>
    <a href="{{ routes.all_products_collection_url | default: routes.collections_url }}" class="text-sm font-medium pb-1 border-b-2 {% if template.name == 'collection' or template.name == 'product' %}border-brand-textDark text-brand-textDark{% else %}border-transparent text-brand-textLight hover:text-brand-textDark transition{% endif %}">Our Products</a>
    <a href="{{ pages['our-story'].url | default: '/pages/our-story' }}" class="text-sm font-medium pb-1 border-b-2 {% if page and page.handle == 'our-story' %}border-brand-textDark text-brand-textDark{% else %}border-transparent text-brand-textLight hover:text-brand-textDark transition{% endif %}">Our Story</a>
    <a href="{{ pages['contact'].url | default: '/pages/contact' }}" class="text-sm font-medium pb-1 border-b-2 {% if page and page.handle == 'contact' %}border-brand-textDark text-brand-textDark{% else %}border-transparent text-brand-textLight hover:text-brand-textDark transition{% endif %}">Contact</a>
  </nav>

  <!-- Icons -->
  <div class="flex items-center gap-5 md:gap-6">
    <a href="{{ routes.search_url }}" class="text-brand-textDark hover:text-brand-olive transition" aria-label="Search">
      <i class="fa-solid fa-magnifying-glass text-lg"></i>
    </a>
    {% if shop.customer_accounts_enabled %}
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="text-brand-textDark hover:text-brand-olive transition" aria-label="{% if customer %}Account{% else %}Login{% endif %}">
        <i class="fa-regular fa-user text-lg"></i>
      </a>
    {% endif %}
    <a href="{{ routes.cart_url }}" class="text-brand-textDark hover:text-brand-olive transition relative" aria-label="Cart">
      <i class="fa-solid fa-cart-shopping text-lg"></i>
      <span class="absolute -top-2 -right-2 bg-brand-olive text-white text-[0.6rem] font-bold w-4 h-4 rounded-full flex items-center justify-center">{{ cart.item_count }}</span>
    </a>
    <button class="md:hidden text-brand-textDark hover:text-brand-olive transition" id="menuBtn" aria-label="Menu">
      <i class="fa-solid fa-bars text-lg"></i>
    </button>
  </div>
</header>

<div class="mobile-menu bg-brand-bg flex flex-col px-6 py-5 font-sans" id="mobileMenu">
  <div class="flex items-center justify-between mb-14">
    <img src="{{ 'primary-logo.png' | asset_url }}" alt="{{ shop.name }}" class="h-11 w-auto">
    <button class="text-brand-textDark text-3xl leading-none p-1" id="menuClose" aria-label="Close menu">&times;</button>
  </div>
  <nav class="flex flex-col gap-7">
    <a href="{{ routes.root_url }}" class="font-serif text-3xl italic text-brand-textDark">Home</a>
    <a href="{{ routes.all_products_collection_url | default: routes.collections_url }}" class="font-serif text-3xl italic text-brand-textDark">Our Products</a>
    <a href="{{ pages['our-story'].url | default: '/pages/our-story' }}" class="font-serif text-3xl italic text-brand-textDark">Our Story</a>
    <a href="{{ pages['contact'].url | default: '/pages/contact' }}" class="font-serif text-3xl italic text-brand-textDark">Contact</a>
    <a href="{{ routes.cart_url }}" class="font-serif text-3xl italic text-brand-textDark">Cart ({{ cart.item_count }})</a>
    {% if shop.customer_accounts_enabled %}
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="font-serif text-3xl italic text-brand-textDark">{% if customer %}My Account{% else %}Login{% endif %}</a>
    {% endif %}
  </nav>
</div>
