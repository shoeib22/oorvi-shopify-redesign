<div class="font-sans antialiased text-brand-textDark bg-brand-bg min-h-screen">
  <section class="w-full pt-28 pb-12 px-6 text-center">
    <p class="uppercase tracking-[0.3em] text-xs font-semibold text-brand-textLight mb-4">Account</p>
    <h1 class="text-4xl md:text-6xl font-serif text-brand-textDark">Welcome back{% if customer.first_name != blank %}, {{ customer.first_name }}{% endif %}.</h1>
  </section>

  <div class="max-w-6xl mx-auto px-6 md:px-12 pb-24 grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-12 items-start">
    <div>
      <h2 class="font-serif text-2xl text-brand-textDark mb-6">Order history</h2>

      {% if customer.orders.size > 0 %}
        <div class="flex flex-col border-t border-brand-border/60">
          {% for order in customer.orders %}
            <a href="{{ order.customer_url }}" class="grid grid-cols-2 md:grid-cols-4 gap-3 items-center py-5 border-b border-brand-border/60 text-sm hover:opacity-70 transition">
              <span class="font-serif text-lg text-brand-textDark">{{ order.name }}</span>
              <span class="text-brand-textLight">{{ order.created_at | date: "%d %b %Y" }}</span>
              <span class="text-brand-textLight">{{ order.fulfillment_status_label }}</span>
              <span class="font-semibold text-brand-olive text-right">{{ order.total_price | money }}</span>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <p class="text-brand-textLight mb-6">No orders yet.</p>
        <a href="{{ routes.all_products_collection_url | default: routes.collections_url }}" class="bg-brand-olive hover:bg-brand-oliveHover text-white px-8 py-3.5 rounded-full inline-flex items-center gap-3 font-medium transition duration-300">
          Start Shopping <i class="fa-solid fa-chevron-right text-xs"></i>
        </a>
      {% endif %}
    </div>

    <div class="bg-brand-card rounded-2xl p-6 lg:sticky lg:top-28">
      <p class="text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-3">Account Details</p>
      <p class="text-brand-textDark font-medium">{{ customer.first_name }} {{ customer.last_name }}</p>
      <p class="text-brand-textLight text-sm mt-1">{{ customer.email }}</p>
      <a href="{{ routes.account_addresses_url }}" class="block text-center w-full border border-brand-border text-brand-textDark py-3.5 rounded-full uppercase tracking-widest text-xs font-bold hover:border-brand-olive hover:text-brand-olive transition mt-6">Manage Addresses</a>
      <a href="{{ routes.account_logout_url }}" class="block text-center w-full border border-brand-border text-brand-textDark py-3.5 rounded-full uppercase tracking-widest text-xs font-bold hover:border-brand-olive hover:text-brand-olive transition mt-3">Log Out</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Account",
  "settings": []
}
{% endschema %}
