<section class="wrap page-intro"><div><p class="eyebrow">From our press to your pantry</p><h1>{% if collection.handle == 'all' %}Everyday goodness.{% else %}{{ collection.title | default: 'Everyday goodness.' | escape }}{% endif %}</h1></div><div>{% if collection.description != blank %}{{ collection.description }}{% else %}<p>Eight oils. Two traditional methods. One simple belief: good food starts with good ingredients.</p>{% endif %}</div></section>
<div class="wrap">
{% paginate collection.products by 16 %}
  <div class="catalog-toolbar"><span>{{ collection.products_count }} oils to make yourself at home with.</span><div><label for="sort-by">Sort by</label> <select id="sort-by" data-sort-by>{% assign current_sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></div></div>
  {% if collection.products.size > 0 %}<div class="oil-grid catalog-grid">{% for product in collection.products %}{% assign tone = forloop.index0 | modulo: 4 | plus: 1 %}{% render 'oil-card', oil: product, tone: tone %}{% endfor %}</div>{% else %}<div class="empty-state"><h2>A little goodness is on its way.</h2><p>Our catalogue is being prepared. Get to know our oils on the homepage, or contact us for availability.</p><a href="{{ routes.root_url }}" class="button">Explore Oorvi {% render 'icon', name: 'arrow' %}</a></div>{% endif %}
  {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Collection pages">{{ paginate | default_pagination }}</nav>{% endif %}
{% endpaginate %}
</div>
{% schema %}
{"name":"Shop oils","settings":[]}
{% endschema %}
