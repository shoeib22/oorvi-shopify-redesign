<div class="font-sans antialiased text-brand-textDark bg-brand-bg min-h-screen">
  <section class="w-full pt-28 pb-12 px-6 text-center">
    <p class="uppercase tracking-[0.3em] text-xs font-semibold text-brand-textLight mb-4">Account</p>
    <h1 class="text-4xl md:text-6xl font-serif text-brand-textDark">Your addresses</h1>
  </section>

  <div class="max-w-5xl mx-auto px-6 md:px-12 pb-24 grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-12 items-start">
    <div>
      {% if customer.addresses.size > 0 %}
        <div class="grid gap-4">
          {% for address in customer.addresses %}
            <div class="bg-white border border-brand-border/50 rounded-2xl p-6">
              {% if address == customer.default_address %}
                <span class="text-[0.65rem] font-bold tracking-widest text-brand-olive uppercase bg-brand-olive/10 px-3 py-1 rounded-full inline-block mb-3">Default</span>
              {% endif %}
              <p class="text-brand-textDark leading-relaxed">
                {{ address.first_name }} {{ address.last_name }}<br>
                {{ address.address1 }}{% if address.address2 != blank %}, {{ address.address2 }}{% endif %}<br>
                {{ address.city }}, {{ address.province }} {{ address.zip }}<br>
                {{ address.country }}
              </p>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p class="text-brand-textLight">No saved addresses yet.</p>
      {% endif %}
    </div>

    <div class="bg-brand-card rounded-2xl p-6 lg:sticky lg:top-28">
      <p class="text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-6">Add a New Address</p>
      {% form 'customer_address', customer.new_address %}
        {% if form.errors %}
          <p class="text-red-700 text-sm mb-4">{{ form.errors | default_errors }}</p>
        {% endif %}
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label for="address-first-name" class="block text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-2">First name</label>
            <input type="text" id="address-first-name" name="address[first_name]" value="{{ form.first_name }}" class="w-full bg-white border border-brand-border rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brand-olive">
          </div>
          <div>
            <label for="address-last-name" class="block text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-2">Last name</label>
            <input type="text" id="address-last-name" name="address[last_name]" value="{{ form.last_name }}" class="w-full bg-white border border-brand-border rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brand-olive">
          </div>
        </div>
        <div class="mb-4">
          <label for="address-1" class="block text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-2">Address</label>
          <input type="text" id="address-1" name="address[address1]" value="{{ form.address1 }}" required class="w-full bg-white border border-brand-border rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brand-olive">
        </div>
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label for="address-city" class="block text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-2">City</label>
            <input type="text" id="address-city" name="address[city]" value="{{ form.city }}" required class="w-full bg-white border border-brand-border rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brand-olive">
          </div>
          <div>
            <label for="address-province" class="block text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-2">State</label>
            <input type="text" id="address-province" name="address[province]" value="{{ form.province }}" class="w-full bg-white border border-brand-border rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brand-olive">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label for="address-zip" class="block text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-2">PIN code</label>
            <input type="text" id="address-zip" name="address[zip]" value="{{ form.zip }}" required class="w-full bg-white border border-brand-border rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brand-olive">
          </div>
          <div>
            <label for="address-country" class="block text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-2">Country</label>
            <select id="address-country" name="address[country]" class="w-full bg-white border border-brand-border rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brand-olive">{{ country_option_tags }}</select>
          </div>
        </div>
        <div class="mb-6">
          <label for="address-phone" class="block text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-2">Phone</label>
          <input type="tel" id="address-phone" name="address[phone]" value="{{ form.phone }}" class="w-full bg-white border border-brand-border rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brand-olive">
        </div>
        <button type="submit" class="w-full bg-brand-olive hover:bg-brand-oliveHover text-white py-3.5 rounded-full uppercase tracking-widest text-xs font-bold transition">Save Address</button>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Addresses",
  "settings": []
}
{% endschema %}
