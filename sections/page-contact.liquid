<section class="page-hero">
  <p class="eyebrow eyebrow--light">Get in Touch</p>
  <h1 class="display">We'd love to<br>hear from you.</h1>
  <p class="page-hero__sub">Questions about an order, wholesale, or just want to say hello — reach us directly or send a message below.</p>
</section>

<div class="contact-layout">
  <div class="reveal">
    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <p class="contact-form__success">Thanks — your message has reached us. We'll reply within a day or two.</p>
      {% else %}
        {% if form.errors %}
          <p class="newsletter__error" style="color:#b5651d;">{{ form.errors | default_errors }}</p>
        {% endif %}
        <div class="contact-form__field">
          <label for="contact-name">Name</label>
          <input type="text" id="contact-name" name="contact[name]" required>
        </div>
        <div class="contact-form__field">
          <label for="contact-email">Email</label>
          <input type="email" id="contact-email" name="contact[email]" required>
        </div>
        <div class="contact-form__field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="contact[body]" rows="6" required></textarea>
        </div>
        <button type="submit" class="btn btn--gold">Send message</button>
      {% endif %}
    {% endform %}
  </div>

  <div class="contact__grid contact__grid--plain reveal">
    <div class="contact__item">
      <span>Phone</span>
      <a href="tel:+919642114488">+91 96421 14488</a>
    </div>
    <div class="contact__item">
      <span>Email</span>
      <a href="mailto:care@oorvi.store">care@oorvi.store</a>
    </div>
    <div class="contact__item">
      <span>Visit</span>
      <p>House No. 7-90/4, Brundavan Colony, Kokapet, Hyderabad, Telangana 500075</p>
    </div>
    <div class="contact__item">
      <span>Hours</span>
      <p>Mon–Sat, 10 AM–6 PM IST</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact",
  "settings": []
}
{% endschema %}
