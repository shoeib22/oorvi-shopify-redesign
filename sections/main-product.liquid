{% assign selected_variant = product.selected_or_first_available_variant %}
{% capture packshot %}{% render 'oil-packshot', oil: product %}{% endcapture %}
<div class="product-layout wrap">
  <div class="product-gallery"><div class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ routes.all_products_collection_url }}">Shop oils</a><span>/</span><span>{{ product.title | escape }}</span></div><div class="product-main-image">{% if product.featured_image %}<img id="product-main-photo" src="{{ packshot | strip }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1000" height="1000" fetchpriority="high">{% else %}<span>Oorvi · Goodness. Naturally.</span>{% endif %}</div>{% if product.images.size > 1 %}<div class="product-thumbnails">{% for image in product.images %}<button type="button" data-product-thumbnail="{{ image | image_url: width: 1000 }}" class="{% if forloop.first %}active{% endif %}" aria-label="View image {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: product.title | escape }}" width="160" height="160" loading="lazy"></button>{% endfor %}</div>{% endif %}</div>
  <div class="product-details"><p class="eyebrow">{% render 'oil-method', oil: product %}</p><h1>{% render 'oil-title', oil: product %}</h1><div class="product-price"><s id="product-compare-price" {% unless selected_variant.compare_at_price > selected_variant.price %}hidden{% endunless %}>{% if selected_variant.compare_at_price > selected_variant.price %}{{ selected_variant.compare_at_price | money }}{% endif %}</s><span id="product-price">{{ selected_variant.price | money }}</span></div><p class="tax-note">Inclusive of taxes. Shipping calculated at checkout.</p><div class="product-description">{{ product.description }}</div>
  {% form 'product', product, class: 'product-form' %}
    {% if form.errors %}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    <div class="product-controls"><div><label class="field-label" for="product-variant">Choose your size</label><select name="id" id="product-variant">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == selected_variant %}selected{% endif %}>{% if variant.title == 'Default Title' %}{% if product.handle contains '500ml' %}500 mL{% else %}1 L{% endif %}{% else %}{{ variant.title | escape }}{% endif %}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select></div><div><label class="field-label" for="product-quantity">Quantity</label><div class="quantity-control"><button type="button" data-quantity="minus" aria-label="Decrease quantity">−</button><input id="product-quantity" type="number" name="quantity" value="1" min="1" aria-label="Quantity"><button type="button" data-quantity="plus" aria-label="Increase quantity">+</button></div></div></div>
    <button id="product-submit" type="submit" class="button" {% unless selected_variant.available %}disabled{% endunless %}><span>{% if selected_variant.available %}Add to your bag{% else %}Sold out{% endif %}</span>{% render 'icon', name: 'bag' %}</button>
  {% endform %}
  <script type="application/json" id="product-variants">[{% for variant in product.variants %}{"id":{{ variant.id | json }},"price":{{ variant.price | money | json }},"compare":{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},"available":{{ variant.available | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
  <div class="product-assurances"><span>{% render 'icon', name: 'drop' %} Single pressed</span><span>{% render 'icon', name: 'leaf' %} Naturally settled</span><span>{% render 'icon', name: 'sun' %} No added preservatives</span></div>
  <div class="questions"><details open><summary>The goodness inside<span>+</span></summary><p>Made from carefully selected seeds, pressed once, and naturally settled. No refining or blending. See your bottle’s label for the complete ingredients and nutritional information.</p></details><details><summary>Keep it fresh<span>+</span></summary><p>Store tightly closed in a cool, dry place away from sunlight. Follow the best-before date and storage instructions on the label. Natural sediment and variations in colour are normal.</p></details><details><summary>Delivery & returns<span>+</span></summary><p>Delivery options and shipping charges are shown at checkout. For help with an order, contact <a href="mailto:care@oorvi.store">care@oorvi.store</a>. Read our <a class="text-link" href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">shipping policy</a> and <a class="text-link" href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">returns policy</a>.</p></details></div>
  </div>
</div>
{% if collections['all'].products.size > 1 %}<section class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">A little more goodness</p><h2>Make room in <em>your pantry.</em></h2></div><a class="text-link" href="{{ routes.all_products_collection_url }}">All oils {% render 'icon', name: 'arrow' %}</a></div><div class="oil-grid">{% assign shown = 0 %}{% for oil in collections['all'].products %}{% if oil.id != product.id %}{% assign shown = shown | plus: 1 %}{% render 'oil-card', oil: oil, tone: shown %}{% if shown == 4 %}{% break %}{% endif %}{% endif %}{% endfor %}</div></section>{% endif %}
{% schema %}
{"name":"Product goodness","settings":[]}
{% endschema %}
