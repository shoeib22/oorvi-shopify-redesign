<div class="font-sans antialiased text-brand-textDark bg-brand-bg min-h-screen">
  <section class="w-full pt-28 pb-12 px-6 text-center">
    <p class="uppercase tracking-[0.3em] text-xs font-semibold text-brand-textLight mb-4">Account</p>
    <h1 class="text-4xl md:text-6xl font-serif text-brand-textDark">Set a new password</h1>
  </section>

  <div class="max-w-md mx-auto px-6 pb-24">
    <div class="bg-white border border-brand-border/60 rounded-3xl p-8 md:p-10">
      {% form 'reset_customer_password' %}
        {% if form.errors %}
          <p class="text-red-700 text-sm mb-6">{{ form.errors | default_errors }}</p>
        {% endif %}

        <div class="mb-6">
          <label for="reset-password" class="block text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-2">New password</label>
          <input type="password" id="reset-password" name="customer[password]" autocomplete="new-password" required
            class="w-full bg-transparent border-b border-brand-border/80 py-3 text-brand-textDark focus:outline-none focus:border-brand-olive transition-colors">
        </div>

        <div class="mb-8">
          <label for="reset-password-confirmation" class="block text-xs font-semibold tracking-widest text-brand-textLight uppercase mb-2">Confirm password</label>
          <input type="password" id="reset-password-confirmation" name="customer[password_confirmation]" autocomplete="new-password" required
            class="w-full bg-transparent border-b border-brand-border/80 py-3 text-brand-textDark focus:outline-none focus:border-brand-olive transition-colors">
        </div>

        <button type="submit" class="w-full bg-brand-olive hover:bg-brand-oliveHover text-white py-4 rounded-full uppercase tracking-widest text-xs font-bold transition shadow-lg shadow-brand-olive/20">Reset Password</button>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reset Password",
  "settings": []
}
{% endschema %}
