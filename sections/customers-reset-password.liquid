<section class="page-hero">
  <p class="eyebrow eyebrow--light">Account</p>
  <h1 class="display">Set a new password</h1>
</section>

<div class="auth-page">
  <div class="auth-card reveal">
    {% form 'reset_customer_password' %}
      {% if form.errors %}
        <p class="newsletter__error" style="color:#b5651d;">{{ form.errors | default_errors }}</p>
      {% endif %}

      <div class="contact-form__field">
        <label for="reset-password">New password</label>
        <input type="password" id="reset-password" name="customer[password]" autocomplete="new-password" required>
      </div>

      <div class="contact-form__field">
        <label for="reset-password-confirmation">Confirm password</label>
        <input type="password" id="reset-password-confirmation" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="btn btn--gold product__submit">Reset password</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Reset Password",
  "settings": []
}
{% endschema %}
