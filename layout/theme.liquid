<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page_title | default: shop.name }}</title>
  <meta name="description" content="Single-pressed, unfiltered cold & wood pressed oils from Hyderabad. A1 native seed, one honest process.">
  <link rel="canonical" href="{{ canonical_url }}">
  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  {{ 'oorvi-theme.css' | asset_url | stylesheet_tag }}

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Alex+Brush&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              bg: '#f4f1ea',
              card: '#e8e3d5',
              olive: '#4a5d23',
              oliveHover: '#3b4a1c',
              textDark: '#2a2d24',
              textLight: '#595c52',
              border: '#d3cfc4',
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            serif: ['Playfair Display', 'serif'],
            cursive: ['Alex Brush', 'cursive'],
          }
        }
      }
    }
  </script>
</head>
<body class="template-{{ template.name }}">
  {% render 'header' %}
  <main>
    {{ content_for_layout }}
  </main>
  {% render 'footer' %}
  <script src="{{ 'oorvi-theme.js' | asset_url }}" defer></script>
</body>
</html>
